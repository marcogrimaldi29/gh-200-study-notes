---
import NoteLayout from '../../layouts/NoteLayout.astro';
import Callout from '../../components/Callout.astro';
import Mermaid from '../../components/Mermaid.astro';
import Mistake from '../../components/Mistake.astro';
import { SITE } from '../../data/site';
import { href } from '../../lib/urls';

const whichReuse = `
flowchart TD
  Q["Share automation across repositories"] --> A{"Should later changes<br/>reach every user?"}
  A -->|"no — a starting point"| T["Workflow template"]
  A -->|"yes"| B{"Whole jobs, with their own<br/>runners, environments, secrets?"}
  B -->|"yes"| R["Reusable workflow<br/>on: workflow_call"]
  B -->|"no — steps inside a job"| C["Composite action"]
`;

const whichCredential = `
flowchart TD
  Q["The workflow must authenticate to…"] --> A{"This repository on GitHub?"}
  A -->|"yes"| GT["GITHUB_TOKEN<br/>with minimal permissions"]
  A -->|"no"| B{"A cloud provider?"}
  B -->|"yes"| OIDC["OIDC federation<br/>id-token: write, no stored key"]
  B -->|"no"| C{"Other repositories, or must<br/>trigger other workflows?"}
  C -->|"yes"| APP["GitHub App installation token"]
  C -->|"no — a third-party service"| SEC["Environment secret<br/>scoped to the deploying job"]
`;
---

<NoteLayout
  slug="exam-tips"
  description="GH-200 final review: key numbers and limits, renames and retired syntax, where the study guide, the Learn modules and the GitHub docs disagree, commonly mistaken topics shown as failed and fixed runs, decision trees, a scenario-to-answer table and a pre-exam checklist."
  intro="Everything you want in your head the night before: the numbers that turn up in answer options, the places where the study guide, the Learn modules and the live documentation disagree, the mistakes candidates make most often, and a lookup table from typical scenario wording to the answer the exam expects."
>
